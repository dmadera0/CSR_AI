# Installed npm packages — never commit these; run `npm install` to restore
node_modules/

# CDK synthesis output — generated by `cdk synth`, not source code
cdk.out/

# TypeScript compiled output — generated by `tsc`, not source code
dist/

# Environment variable files — may contain secrets (API keys, passwords)
.env
.env.local
.env.*.local

# TypeScript source maps — generated build artifacts
*.js.map

# Test coverage reports — generated by test runners
coverage/

# macOS metadata files
.DS_Store

# Editor directories and files
.vscode/
.idea/
*.swp
*.swo
