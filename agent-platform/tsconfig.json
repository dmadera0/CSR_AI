{
  "compilerOptions": {
    "target": "ES2020",       // Compile to ES2020 — supported by Node.js 20
    "lib": ["es2020"],        // Type definitions available at runtime
    "module": "commonjs",     // CDK CLI expects CommonJS modules
    "strict": true,           // Enable all strict type checks
    "esModuleInterop": true,  // Allow default imports from CommonJS packages
    "skipLibCheck": true,     // Skip type-checking of .d.ts files in node_modules
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",         // Compiled JS output (not committed)
    "rootDir": "."            // Source root — keeps dist/ structure matching src/
  },
  // Only compile CDK source files; the lambda/ folder is plain JS and excluded.
  "include": ["bin/**/*.ts", "lib/**/*.ts"],
  "exclude": ["node_modules", "lambda"]
}
